<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">

  <f:entry title="Analyzers" field="analyzers"
           description="Comma-separated list: code-review, vulnerability, architecture-drift, test-gaps, dependency-risk, commit-intel, pipeline-advisor, release-readiness">
    <f:textbox default="code-review,vulnerability,architecture-drift,test-gaps"/>
  </f:entry>

  <f:entry title="Source File Glob" field="sourceGlob"
           description="Glob patterns for source files to analyze (comma-separated)">
    <f:textbox default="**/*.java,**/*.py,**/*.js,**/*.ts"/>
  </f:entry>

  <f:entry title="Scope" field="scope"
           description="Which files the code analyzers read. Automatic analyzes only changed files on pull request builds.">
    <select name="scope" class="jenkins-select__input">
      <f:option value="auto" selected="${instance == null or instance.scope == 'auto'}">Automatic: changed files on pull requests, all files otherwise</f:option>
      <f:option value="changes" selected="${instance.scope == 'changes'}">Only files changed since the base revision</f:option>
      <f:option value="all" selected="${instance.scope == 'all'}">All files matching the glob</f:option>
    </select>
  </f:entry>

  <f:entry title="Base Revision" field="baseRef"
           description="Optional branch, tag or commit to compare against, e.g. origin/main. Defaults to the pull request's target branch.">
    <f:textbox/>
  </f:entry>

  <f:entry title="Additional Context" field="contextInfo"
           description="Optional project description, architecture info, or constraints">
    <f:textarea/>
  </f:entry>

  <f:entry title="Fail on Low Score" field="failOnCritical"
           description="Omit to use the global setting. Also fails the build when an analyzer errors.">
    <f:checkbox/>
  </f:entry>

  <f:entry title="Score Threshold" field="criticalThreshold"
           description="Minimum composite score (1-10). Leave empty to use the global setting.">
    <f:number min="1" max="10"/>
  </f:entry>

</j:jelly>
