/**
 * ForgeAI — Air-gapped / Local LLM mode using Ollama.
 *
 * Prerequisites:
 *   1. Run Ollama somewhere the Jenkins *controller* can reach: https://ollama.com
 *      ForgeAI makes its LLM calls from the controller, not from the build agent,
 *      so an Ollama installed only on an agent is not used.
 *   2. Pull a code-focused model: ollama pull deepseek-coder:33b
 *   3. In Jenkins global config, set:
 *        Provider: Ollama (Local)
 *        Endpoint: http://localhost:11434   (Ollama on the controller host)
 *              or: http://ollama.internal:11434
 *        Model: deepseek-coder:33b
 *
 * No API keys required. No data leaves your network.
 */

pipeline {
    agent any  // the agent only provides the workspace; the LLM runs wherever Ollama is

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('ForgeAI Local Analysis') {
            steps {
                script {
                    def report = forgeAI(
                        analyzers: ['code-review', 'vulnerability', 'test-gaps'],
                        sourceGlob: 'src/**/*.py',
                        contextInfo: 'Python FastAPI service, air-gapped environment'
                    )
                    echo "Composite Score: ${report.compositeScore}/10"
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'forgeai-reports/**', allowEmptyArchive: true
                }
            }
        }
    }
}
